# Server-only backend base URL.
# Never rename this to NEXT_PUBLIC_*.
ELECT_BACKEND_URL=

# Optional request timeout in milliseconds.
ELECT_BACKEND_TIMEOUT_MS=10000

# Optional server-only allowlist for /results?code=...
# Matching is case-insensitive; for example TGA-02 accepts tga-02.
ELECT_PUBLIC_RESULTS_CONSTITUENCY_CODE=
